{%- for message in messages -%}
    {%- if message['content'] is string -%}
        {{- raise_exception('NP3.5 native template requires content arrays') -}}
    {%- endif -%}
    {%- for part in message['content'] -%}
        {%- if part['type'] == 'image' or part['type'] == 'image_url' -%}
            {{- '<pad>\n' -}}
        {%- endif -%}
    {%- endfor -%}
    {%- for part in message['content'] -%}
        {%- if part['type'] == 'text' -%}
            {{- part['text'] -}}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}
