# Image for indic_granary_pipeline.yaml: the Granary base (TensorRT, TensorRT-LLM, NeMo,
# SpeechBrain, Whisper) plus the Dynamo driver for the text model. It adds no in-process vLLM:
# the Indic ASR stages run on TensorRT-LLM / NeMo, and Dynamo resolves its own vLLM in isolated
# Ray worker environments.
# Build with `docker buildx bake -f tutorials/audio/granary_v2/full_pipeline/docker-bake.hcl`
# from the repository root: bake builds docker/audio/Dockerfile.trt_llm --target granary and
# passes it here as the named context `granary`. The base already holds this checkout at
# /opt/Curator, so nothing is copied here.
FROM granary

# Freeze every installed package as an override so the TensorRT-LLM stack stays unchanged.
RUN uv pip freeze --python /opt/venv/bin/python --exclude-editable > /tmp/granary-overrides.txt \
    && uv pip install --no-config --no-sources --python /opt/venv/bin/python \
        --overrides /tmp/granary-overrides.txt --only-binary :all: \
        'ai-dynamo==1.3.1' 'nixl-cu12==1.0.0' \
    && rm /tmp/granary-overrides.txt

RUN bash /opt/Curator/docker/common/install_etcd_nats.sh

# The text model's serving workers JIT-compile FlashInfer kernels with CUDA 12.9 (selected through
# CUDA_HOME in the YAML's runtime_env); the audio runtime keeps its CUDA 12.8 alias.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cuda-nvcc-12-9=12.9.86-1 cuda-cudart-dev-12-9=12.9.79-1 \
        cuda-cccl-12-9=12.9.27-1 libcurand-dev-12-9 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set cuda /usr/local/cuda-12.8
