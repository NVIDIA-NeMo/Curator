# Opt-in layer for Indic Canary. Build the ordinary Curator image from the
# same commit first, then pass its immutable tag or digest as CURATOR_BASE_IMAGE.
# The default Curator Dockerfile remains unchanged.
ARG CURATOR_BASE_IMAGE=curator-base:local
FROM ${CURATOR_BASE_IMAGE}

ARG CUDA_COMPAT_13_VERSION=610.57.04-1ubuntu1

USER root

# Provide CUDA 13.3 forward compatibility for EOS H100 nodes whose host driver
# predates CUDA 13. This path is supported only on NVIDIA data-center GPUs;
# consumer GPUs still require a native compatible driver.
RUN apt-get update && \
    apt-get install -y --no-install-recommends cuda-compat-13-3=${CUDA_COMPAT_13_VERSION} && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install the compatible parent TensorRT profile, then create a second Python
# 3.12 environment from the packaged frozen lock. TensorRT-LLM never enters
# /opt/venv, Curator's parent environment.
RUN cd /opt/Curator && \
    uv sync --locked --extra all --extra audio_canary_trtllm --all-groups --no-cache && \
    UV_PYTHON_INSTALL_DIR=/opt/nemo-curator-runtimes/python \
    /opt/venv/bin/python -m \
    nemo_curator.stages.audio.inference.scripts.install_indic_canary_trtllm_runtime \
    --runtime-root /opt/nemo-curator-runtimes/indic-canary-trtllm && \
    rm -rf /opt/uv_cache/*

ENV NEMO_CURATOR_INDIC_CANARY_RUNTIME_PYTHON="/opt/nemo-curator-runtimes/indic-canary-trtllm/bin/python"
